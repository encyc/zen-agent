{
  "id": "glob_python_files",
  "prompt": "Use the glob tool to list every Python file under the current directory. Answer with the file paths, one per line.",
  "setup": {
    "files": {
      "pkg/a.py": "a = 1\n",
      "pkg/b.py": "b = 2\n",
      "pkg/data.json": "{}\n",
      "notes.md": "hi\n"
    }
  },
  "options": {
    "max_turns": 6,
    "thinking": "off"
  },
  "expect": {
    "tools": [
      "glob"
    ],
    "output_contains": [
      "pkg/a.py",
      "pkg/b.py"
    ],
    "output_not_contains": [
      "pkg/data.json"
    ],
    "termination": "stop",
    "max_cost": 0.08
  }
}
