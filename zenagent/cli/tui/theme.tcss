/* ZenAgent TUI — "harbor": cold slate with a single warm accent.
   Tokens: ink #0d1319 · surface #141c24 · line #263441
           text #d7e0e8 · muted #8296a6 · accent #d9a86c · error #e08787

   Layout follows omp's single-column dock:
     #transcript (1fr)  →  #status-band (1 row)  →  #prompt-row (╰─ + input)
   No bottom status bar, no frame around the prompt. */

Screen {
    background: #0d1319;
    color: #d7e0e8;
}

#root {
    height: 1fr;
}

#main-column {
    width: 1fr;
    height: 1fr;
}

#transcript {
    height: 1fr;
    background: #0d1319;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

#command-hints {
    height: auto;
    max-height: 8;
    background: #141c24;
    padding: 0 1;
}

#new-content {
    height: 1;
    background: #141c24;
    padding: 0 1;
}

#dock {
    height: auto;
    background: #0d1319;
}

/* The band is a filled strip flush with the left edge, omp's default shape. */
#status-band {
    height: 1;
    background: #141c24;
    padding: 0 0;
}

#prompt-row {
    height: auto;
    background: #0d1319;
}

#prompt-input {
    width: 1fr;
    height: 1;
    background: #0d1319;
    border: none;
    padding: 0 1 0 0;
}

#work-indicator {
    width: auto;
    height: 1;
    padding: 0 1 0 1;
    color: #d9a86c;
    background: #0d1319;
}

#prompt-input:focus {
    background: #0d1319;
}

.welcome {
    color: #d7e0e8;
    text-align: center;
    margin: 1 0 1 0;
}

#sidebar {
    width: 26;
    height: 1fr;
    background: #141c24;
    border-left: solid #263441;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

/* omp: the user turn is a filled full-width bar, no prefix. */
.user-message {
    background: #1b222a;
    color: #d7e0e8;
    padding: 0 1;
    margin: 1 0 0 0;
    width: 100%;
}

.assistant-message {
    margin: 0 0 1 0;
}

.thinking-row {
    background: #0d1319;
    border: none;
    /* A collapsed preview must never wrap, even before the first layout pass
       knows the real width (the widget clips its own text to the row too). */
    height: 1;
    text-wrap: nowrap;
    margin: 0 0 0 1;
    color: #8296a6;
}

.thinking-row.expanded {
    height: auto;
    text-wrap: wrap;
}

.thinking-row:focus {
    color: #d9a86c;
}

.skill-message {
    background: #0d1319;
    border: none;
    height: 1;
    text-wrap: nowrap;
    margin: 0 0 0 1;
    color: #d7e0e8;
}

.skill-message.expanded {
    height: auto;
    text-wrap: wrap;
}

.skill-message:focus {
    color: #d9a86c;
}

/* omp's plain-tinted cards: body tint by state, success stays quiet. */
.tool-card {
    background: #0d1319;
    height: auto;
    margin: 0 0 0 0;
    color: #8296a6;
}

.tool-card.-running {
    background: #121a22;
}

.tool-card.-ok {
    background: #10171e;
}

.tool-card.-error {
    background: #241a1a;
}

.tool-card:focus {
    color: #d9a86c;
}

.usage-row {
    color: #5d6f7e;
    margin: 0 0 1 0;
}

.notice {
    color: #8296a6;
    margin: 0 0 1 0;
}

/* Sticky provider-error banner (dock row, hidden while there is no error). */
#error-banner {
    height: 1;
    background: #3a1d1f;
    color: #e08787;
    padding: 0 1;
}

/* Pending image attachments (one chip per image; hidden while empty). */
#attachment-chips {
    height: 1;
    background: #141c24;
    padding: 0 1;
}

.attachment-chip {
    width: auto;
    height: 1;
    color: #8296a6;
    margin: 0 1 0 0;
}
