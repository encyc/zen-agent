Screen {
    layout: vertical;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 30;
    border: round $accent;
    padding: 0 1;
}

#chat {
    width: 1fr;
    border: round $accent;
    padding: 0 1;
}

.user-message {
    color: $text-muted;
}

.usage-row {
    color: $text-muted;
}

StatusBar {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}

#prompt-input {
    height: 5;
    border: round $accent;
}

.modal {
    width: 70%;
    height: 60%;
    border: thick $accent;
    background: $panel;
    padding: 1 2;
}
