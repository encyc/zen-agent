/* ZenAgent TUI — "harbor": cold slate with a single warm accent.
   Colours come from the active appearance's Textual theme: $ink, $surface,
   $line, $foreground, $muted, $dim, $accent, $success, $error, $warning and
   the $tool-*-bg tints.

   Layout follows omp's single-column dock:
     #transcript (1fr)  →  #status-band (1 row)  →  #prompt-row (╰─ + input)
   No bottom status bar, no frame around the prompt. */

Screen {
    background: $ink;
    color: $foreground;
}

#root {
    height: 1fr;
}

#main-column {
    width: 1fr;
    height: 1fr;
}

#transcript-stack {
    height: 1fr;
}

#transcript {
    height: 1fr;
    background: $ink;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

#subagent-transcript {
    height: 1fr;
    background: $ink;
    padding: 1 2;
    scrollbar-size-vertical: 1;
    display: none;
}

#command-hints {
    height: auto;
    max-height: 8;
    background: $surface;
    padding: 0 1;
}

#new-content {
    height: 1;
    background: $surface;
    padding: 0 1;
}

#dock {
    height: auto;
    background: $ink;
}

/* The band is a filled strip flush with the left edge, omp's default shape. */
#status-band {
    height: 1;
    background: $surface;
    padding: 0 0;
}

#prompt-row {
    height: auto;
    background: $ink;
}

#prompt-input {
    width: 1fr;
    height: 1;
    background: $ink;
    border: none;
    padding: 0 1 0 0;
}

#work-indicator {
    width: auto;
    height: 1;
    padding: 0 1 0 1;
    color: $accent;
    background: $ink;
}

#prompt-input:focus {
    background: $ink;
}

.welcome {
    color: $foreground;
    text-align: center;
    margin: 1 0 1 0;
}

#sidebar {
    width: 26;
    height: 1fr;
    background: $surface;
    border-left: solid $line;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

/* omp: the user turn is a filled full-width bar, no prefix. */
.user-message {
    background: $raised;
    color: $foreground;
    padding: 0 1;
    margin: 1 0 0 0;
    width: 100%;
}

.assistant-message {
    margin: 0 0 1 0;
}

.thinking-row {
    background: $ink;
    border: none;
    /* A collapsed preview must never wrap, even before the first layout pass
       knows the real width (the widget clips its own text to the row too). */
    height: 1;
    text-wrap: nowrap;
    margin: 0 0 0 1;
    color: $muted;
}

.thinking-row.expanded {
    height: auto;
    text-wrap: wrap;
}

.thinking-row:focus {
    color: $accent;
}

.skill-message {
    background: $ink;
    border: none;
    height: 1;
    text-wrap: nowrap;
    margin: 0 0 0 1;
    color: $foreground;
}

.skill-message.expanded {
    height: auto;
    text-wrap: wrap;
}

.skill-message:focus {
    color: $accent;
}

/* omp's plain-tinted cards: body tint by state, success stays quiet. */
.tool-card {
    background: $ink;
    height: auto;
    margin: 0 0 0 0;
    color: $muted;
}

.tool-card.-running {
    background: $tool-running-bg;
}

.tool-card.-ok {
    background: $tool-ok-bg;
}

.tool-card.-error {
    background: $tool-error-bg;
}

.tool-card:focus {
    color: $accent;
}

.usage-row {
    color: $dim;
    margin: 0 0 1 0;
}

.notice {
    color: $muted;
    margin: 0 0 1 0;
}

/* Sticky provider-error banner (dock row, hidden while there is no error). */
#error-banner {
    height: 1;
    background: $error-banner-bg;
    color: $error;
    padding: 0 1;
}

/* Pending image attachments (one chip per image; hidden while empty). */
#attachment-chips {
    height: 1;
    background: $surface;
    padding: 0 1;
}

.attachment-chip {
    width: auto;
    height: 1;
    color: $muted;
    margin: 0 1 0 0;
}
